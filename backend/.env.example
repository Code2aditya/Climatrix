# Environment Configuration - Climatrix Platform
PROJECT_NAME="Climatrix - Enterprise Climate Resilience Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
SECRET_KEY="super-secret-jwt-key-replace-in-production-for-climate-platform"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + PostGIS in production, SQLite fallback for local testing)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urban_heat_db"
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH="urban_heat_dev.db"

# Object Storage / File Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=25

# Razorpay Payment Gateway (Test credentials)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Jalandhar Pilot Configuration
PILOT_CITY="Jalandhar"
PILOT_STATE="Punjab"
PILOT_COUNTRY="India"
PILOT_DEFAULT_LAT=31.3260
PILOT_DEFAULT_LNG=75.5762
